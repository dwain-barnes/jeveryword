{
  "name": "jeveryword",
  "version": "0.2.0",
  "description": "Field extraction and PII redaction with exact offsets, run on LiquidAI's d1-2B on your own machine. A fork of jkrup/jeveryword that no longer calls TypeSafe's hosted Jev.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./client": {
      "types": "./src/client.d.ts",
      "default": "./src/client.mjs"
    },
    "./testing": {
      "types": "./src/testing.d.ts",
      "default": "./src/testing.mjs"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "examples",
    "server"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "d1",
    "liquid",
    "local",
    "extraction",
    "pii",
    "redaction",
    "span",
    "structured-data"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "Justin Krup",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwain-barnes/jeveryword.git"
  },
  "homepage": "https://github.com/dwain-barnes/jeveryword#readme"
}
